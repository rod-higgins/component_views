<?php

/**
 * @file
 * Enhanced Views integration for Component Field module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Render\Element;

/**
 * Implements hook_views_data().
 */
function component_views_views_data() {
  $data = [];
  
  try {
    // Get all component field storage configs
    $field_storage_configs = \Drupal::entityTypeManager()
      ->getStorage('field_storage_config')
      ->loadByProperties(['type' => 'component_field']);

    foreach ($field_storage_configs as $field_storage) {
      $entity_type = $field_storage->getTargetEntityTypeId();
      $field_name = $field_storage->getName();
      $table_name = $entity_type . '__' . $field_name;
      
      // Component Type field
      $data[$table_name][$field_name . '_component_type'] = [
        'title' => t('@field Component Type', ['@field' => $field_storage->label()]),
        'help' => t('The type of component being used.'),
        'field' => [
          'id' => 'component_field',
          'field_name' => $field_name,
        ],
        'filter' => [
          'id' => 'component_type',
          'field_name' => $field_name,
        ],
        'argument' => [
          'id' => 'component_type',
          'field_name' => $field_name,
        ],
        'sort' => [
          'id' => 'standard',
        ],
      ];

      // Configuration field (for advanced users)
      $data[$table_name][$field_name . '_configuration'] = [
        'title' => t('@field Configuration', ['@field' => $field_storage->label()]),
        'help' => t('The JSON configuration of the component.'),
        'field' => [
          'id' => 'standard',
          'click sortable' => FALSE,
        ],
        'filter' => [
          'id' => 'string',
        ],
      ];

      // Component Version field (for cache invalidation)
      $data[$table_name][$field_name . '_component_version'] = [
        'title' => t('@field Version', ['@field' => $field_storage->label()]),
        'help' => t('The version hash of the component.'),
        'field' => [
          'id' => 'standard',
          'click sortable' => TRUE,
        ],
        'filter' => [
          'id' => 'string',
        ],
        'sort' => [
          'id' => 'standard',
        ],
      ];
    }
    
  } catch (\Exception $e) {
    \Drupal::logger('component_views')->error(
      'Error building Views data: @error',
      ['@error' => $e->getMessage()]
    );
  }

  return $data;
}

/**
 * Implements hook_views_data_alter().
 */
function component_views_views_data_alter(array &$data) {
  // Add additional relationships or computed fields if needed
  try {
    // Add a computed field for component count per entity
    foreach ($data as $table_name => &$table_data) {
      if (strpos($table_name, '__field_component_field') !== FALSE) {
        $table_data['component_count'] = [
          'title' => t('Component Count'),
          'help' => t('The number of components in this field.'),
          'field' => [
            'id' => 'numeric',
            'click sortable' => TRUE,
          ],
          'sort' => [
            'id' => 'standard',
          ],
        ];
      }
    }
  } catch (\Exception $e) {
    \Drupal::logger('component_views')->warning(
      'Error altering Views data: @error',
      ['@error' => $e->getMessage()]
    );
  }
}

