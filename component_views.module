}

/**
 * Implements hook_preprocess_views_view().
 */
function component_views_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  
  // Add component-specific CSS classes to views that display component fields
  if (component_views_view_has_component_fields($view)) {
    if (!isset($variables['attributes']['class'])) {
      $variables['attributes']['class'] = [];
    }
    $variables['attributes']['class'][] = 'view-with-component-fields';
    
    // Add library for enhanced component styling
    $variables['#attached']['library'][] = 'component_views/view';
    
    // Add component stats to drupalSettings for JS enhancements
    try {
      $helper = \Drupal::service('component_views.helper');
      $stats = $helper->getComponentUsageStats();
      $variables['#attached']['drupalSettings']['componentViews']['usageStats'] = $stats;
    } catch (\Exception $e) {
      // Silently continue if stats can't be loaded
    }
  }
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function component_views_preprocess_views_view_field(&$variables) {
  /** @var \Drupal\views\Plugin\views\field\FieldPluginBase $field */
  $field = $variables['field'];
  
  if ($field->getPluginId() === 'component_field') {
    $variables['attributes']['class'][] = 'views-field-component-field';
    
    // Add component type as CSS class if available
    $row = $variables['row'];
    if (isset($row->_entity)) {
      $entity = $row->_entity;
      $field_name = $field->definition['field_name'];
      
      if ($entity->hasField($field_name)) {
        $field_items = $entity->get($field_name);
        if (!$field_items->isEmpty()) {
          $component_types = [];
          foreach ($field_items as $item) {
            $component_type = $item->get('component_type')->getValue();
            if (!empty($component_type)) {
              $component_types[] = 'component-type-' . str_replace('_', '-', $component_type);
            }
          }
          if (!empty($component_types)) {
            $variables['attributes']['class'] = array_merge(
              $variables['attributes']['class'] ?? [],
              $component_types
            );
          }
        }
      }
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for views_ui_config_item_form.
 */
function component_views_form_views_ui_config_item_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();
  
  if (method_exists($form_object, 'getType') && $form_object->getType() === 'filter') {
    $item = $form_state->get('handler');
    
    if ($item && $item->getPluginId() === 'component_type') {
      // Add helper text for component type filter
      $form['options']['helper_text'] = [
        '#type' => 'details',
        '#title' => t('Component Filter Help'),
        '#open' => FALSE,
        '#weight' => 100,
        'content' => [
          '#markup' => '<div class="component-views-filter-help">' .
            '<p>' . t('This filter allows you to show only content that uses specific component types.') . '</p>' .
            '<ul>' .
            '<li>' . t('Select multiple components to show content using any of those components') . '</li>' .
            '<li>' . t('Use "Is not one of" to exclude specific component types') . '</li>' .
            '<li>' . t('Leave empty to show all content regardless of components used') . '</li>' .
            '</ul>' .
            '</div>',
        ],
      ];
    }
  }
}

/**
 * Implements hook_views_plugins_display_alter().
 */
function component_views_views_plugins_display_alter(array &$plugins) {
  // Add component-optimized display plugin
  $plugins['component_display'] = [
    'id' => 'component_display',
    'module' => 'component_views',
    'title' => t('Component Display'),
    'help' => t('Optimized display for component-heavy content.'),
    'theme' => 'views_view',
    'class' => 'Drupal\component_views\Plugin\views\display\ComponentDisplay',
    'parent' => 'default',
    'uses_menu' => FALSE,
    'uses_route' => FALSE,
    'contextual_links_locations' => ['view'],
    'admin' => t('Component Display'),
  ];
}

/**
 * Check if a view has component fields.
 */
function component_views_view_has_component_fields($view) {
  if (!$view || !method_exists($view, 'getDisplay')) {
    return FALSE;
  }
  
  try {
    $display = $view->getDisplay();
    if (!$display || !method_exists($display, 'getHandlers')) {
      return FALSE;
    }
    
    $fields = $display->getHandlers('field');
    
    foreach ($fields as $field) {
      if (is_object($field) && method_exists($field, 'getPluginId')) {
        if ($field->getPluginId() === 'component_field') {
          return TRUE;
        }
      }
    }
  } catch (\Exception $e) {
    // Silently return FALSE if we can't determine
  }
  
  return FALSE;
}

/**
 * Implements hook_views_pre_render().
 */
function component_views_views_pre_render($view) {
  // Add performance optimizations for component field views
  if (component_views_view_has_component_fields($view)) {
    try {
      // Pre-load component definitions to avoid multiple discovery calls
      $discovery = \Drupal::service('component_field.discovery');
      $components = $discovery->discoverComponents();
      
      // Store in view for access by field plugins
      $view->component_definitions = $components;
      
      // Add cache metadata
      $view->element['#cache']['tags'][] = 'component_field';
      $view->element['#cache']['contexts'][] = 'component_field.discovery';
      
    } catch (\Exception $e) {
      \Drupal::logger('component_views')->warning(
        'Error pre-loading components for view: @error',
        ['@error' => $e->getMessage()]
      );
    }
  }
}

