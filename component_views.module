  }
}

/**
 * Implements hook_library_info_build().
 */
function component_views_library_info_build() {
  $libraries = [];
  
  // Add dynamic component-specific CSS if available
  try {
    $discovery = \Drupal::service('component_field.discovery');
    $components = $discovery->discoverComponents();
    
    foreach ($components as $name => $component) {
      if (!empty($component['css_file']) && file_exists($component['css_file'])) {
        $css_path = str_replace(DRUPAL_ROOT . '/', '', $component['css_file']);
        $libraries["component.{$name}"] = [
          'css' => [
            'component' => [
              $css_path => ['weight' => 0],
            ],
          ],
          'dependencies' => [
            'component_views/base',
          ],
        ];
      }
    }
  } catch (\Exception $e) {
    \Drupal::logger('component_views')->debug(
      'Error building component libraries: @error',
      ['@error' => $e->getMessage()]
    );
  }
  
  return $libraries;
}

/**
 * Implements hook_cache_flush().
 */
function component_views_cache_flush() {
  // Clear Views cache when component discovery is refreshed
  try {
    if (\Drupal::hasService('views.views_data')) {
      \Drupal::service('views.views_data')->clear();
    }
  } catch (\Exception $e) {
    // Silently continue - not critical
  }
}